# --- LLM (OpenRouter: chat + embeddings) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=anthropic/claude-3.5-sonnet
# --- Embeddings ---
EMBED_MODEL=openai/text-embedding-3-large
EMBED_DIMENSIONS=1536
# --- Postgres (LangGraph checkpointer + pgvector store) ---
DATABASE_URL=postgresql+psycopg://socratic:socratic@localhost:5432/socratic
# --- Observability (optional) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=socratic
# --- Frontend -> agent ---
AGENT_URL=http://localhost:8123
